     "pattern": "–⏑–⏑–⏑⏑–⏑–⏑",
     "scanner": "–⏑?⏑–⏑⏑?⏑–⏑"
    },
    {
     "line": 2,
     "text": "παῖ Δίος δολόπλοκε, λίσσομαί σε·",
     "units": 11,
     "fit": true,
     "pattern": "–⏑–⏑–⏑⏑–⏑–⏑",
     "scanner": "–⏑–⏑?⏑⏑–⏑–⏑"
    },
    {
     "line": 3,
     "text": "μή μ᾽ ἄσαισι μηδ᾽ ὀνίαισι δάμνα,",
