     "pattern": "–⏑–⏑–⏑⏑–⏑––",
     "scanner": "–⏑–⏑–⏑⏑–⏑––"
    },
    {
     "line": 4,
     "text": "πότνια, θῦμον,",
     "units": 5,
     "fit": true,
     "pattern": "–⏑⏑–⏑",
     "scanner": "?⏑⏑–⏑"
    },
    {
     "line": 5,
     "text": "ἀλλὰ τυίδ᾽ ἔλθ᾽, αἴ ποτα κἀτέρωτα",
     "units": 11,
     "fit": true,
     "pattern": "–⏑–––⏑⏑–⏑–⏑",
     "scanner": "–?–––⏑⏑–⏑–⏑"
    },
    {
     "line": 6,
     "text": "τὰς ἔμας αὔδας ἀίοισα πήλοι",
     "units": 11,
     "fit": true,
     "pattern": "–⏑–––⏑⏑–⏑––",
     "scanner": "–⏑–––⏑⏑–⏑––"
    },
    {
     "line": 7,
     "text": "ἔκλυες, πάτρος δὲ δόμον λίποισα",
     "units": 11,
     "fit": true,
     "pattern": "–⏑–––⏑⏑–⏑–⏑",
     "scanner": "??–?–⏑⏑–⏑–⏑"
    },
    {
     "line": 8,
     "text": "χρύσιον ἦλθες",
     "units": 5,
     "fit": true,
     "pattern": "–⏑⏑–⏑",
     "scanner": "–⏑⏑–⏑"
    },
    {
     "line": 9,
     "text": "ἄρμ᾽ ὐπασδεύξαισα· κάλοι δέ σ᾽ ἆγον",
