     "fit": true,
     "pattern": "–⏑–––⏑⏑–⏑–⏑",
     "scanner": "–⏑–––⏑?–⏑–⏑"
    },
    {
     "line": 14,
     "text": "μειδιαίσαισ᾽ ἀθανάτωι προσώπωι",
