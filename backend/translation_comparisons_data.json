ίσταν ἀπυλείποντα μόναν ἴαν⁴\n10 παχέων ἀπὺ πέμπων . . . .","paired_greek_images":[{"page_url":"https://archive.org/details/lyragraecabeingr01edmouoft/page/n423/mode/1up","printed_page":"402","scan_leaf":424,"sha256":"9b85cfc821178f7030c2d8384aa9d496cfb3bff0675102d446f3d6d8c603b341","url":"https://iiif.archive.org/image/iiif/3/lyragraecabeingr01edmouoft%2Flyragraecabeingr01edmouoft_jp2.zip%2Flyragraecabeingr01edmouoft_jp2%2Flyragraecabeingr01edmouoft_0424.jp2/full/max/0/default.jpg"},{"page_url":"https://archive.org/details/lyragraecabeingr01edmouoft/page/n425/mode/1up","printed_page":"404","scan_leaf":426,"sha256":"953c205ff4ea3ade6d1ef521fa7abed77a9e02e558299f014bb01c1082194f86","url":"https://iiif.archive.org/image/iiif/3/lyragraecabeingr01edmouoft%2Flyragraecabeingr01edmouoft_jp2.zip%2Flyragraecabeingr01edmouoft_jp2%2Flyragraecabeingr01edmouoft_0426.jp2/full/max/0/default.jpg"}],"paired_greek_transcription_status":"audited_source_OCR","quality":"source_scan_OCR_independently_visually_audited","reuse_status":"public_domain_us_edition","scope":"whole_poem_other_edition","selection_aligned":false,"source_note_markers":[],"source_notes":[],"source_provenance":[{"language":"grc","ocr_sha256":"587abe081e0f4a7d2708cf00e06e5944279f2bd9563759c9ea9a394bb83a8c1a","source_block_index":9,"source_image":{"page_url":"https://archive.org/details/lyragraecabeingr01edmouoft/page/n423/mode/1up","printed_page":"402","scan_leaf":424,"sha256":"9b85cfc821178f7030c2d8384aa9d496cfb3bff0675102d446f3d6d8c603b341","url":"https://iiif.archive.org/image/iiif/3/lyragraecabeingr01edmouoft%2Flyragraecabeingr01edmouoft_jp2.zip%2Flyragraecabeingr01edmouoft_jp2%2Flyragraecabeingr01edmouoft_0424.jp2/full/max/0/default.jpg"}},{"language":"eng","ocr_sha256":"fa322071e1d8611ef23f3c4d9d1b521027cb845b5c4325c2f1f1bdbbad0da636","source_block_index":9,"source_image":{"page_url":"https://archive.org/details/lyragraecabeingr01edmouoft/page/n424/mode/1up","printed_page":"403","scan_leaf":425,"sha256":"ee6f291