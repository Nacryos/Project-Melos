{
  "version": "search-eval-o-v1",
  "created": "2026-10-09",
  "purpose": "General search-quality evaluation for release O: English concepts, Greek headwords, epithets and phrases across poets. Written before measuring and not tuned to individual fixes; every third query is held out.",
  "judgement_rule": "A passage is relevant when it is Greek edited text (kind text, quality source_text or machine_corrected_ocr) whose normalised text (backend.textutils.normalize: lower case, no accents, final sigma as σ) matches the query's pattern: the concept, headword or epithet is actually present in the Greek. Relevance is judged on the passage (a fragment and its other editions are one item: only the first-ranked copy counts). Patterns are written from the Greek vocabulary of the concept, independently of the lemma index.",
  "metric": "nDCG@10 with binary gains; ideal DCG assumes min(10, number of relevant items) relevant results. Also P@10 and the rank of the first relevant result.",
  "queries": [
    {"q": "moon", "type": "english_concept", "pattern": "\\bσελ[ηα]νν?[αηε]|\\bμην[ηα]\\b|\\bσεληναι"},
    {"q": "stars", "type": "english_concept", "pattern": "\\bαστ[ηε]ρ|\\bαστρ[οαω]"},
    {"q": "wine", "type": "english_concept", "pattern": "\\bοιν[οωευ]"},
    {"q": "honey", "type": "english_concept", "pattern": "\\bμελι\\b|\\bμελιτ[οι]"},
    {"q": "rose", "type": "english_concept", "pattern": "\\bβ?ροδ[οαεω]"},
    {"q": "sleep", "type": "english_concept", "pattern": "\\bυπν[οωευ]"},
    {"q": "death", "type": "english_concept", "pattern": "\\bθανατ"},
    {"q": "old age", "type": "english_concept", "pattern": "\\bγηρα|\\bγηρ[αω]σ"},
    {"q": "nightingale", "type": "english_concept", "pattern": "\\bαηδο[νι]|\\bαηδω"},
    {"q": "swallow", "type": "english_concept", "pattern": "\\bχελιδ"},
    {"q": "horse", "type": "english_concept", "pattern": "\\bιππ(οσ|ου|ω|ον|οι|ων|οισ|οισι|οισιν|ουσ|ε)\\b"},
    {"q": "gold", "type": "english_concept", "pattern": "\\bχρυσ"},
    {"q": "lyre", "type": "english_concept", "pattern": "\\bλυρ[αηε]|\\bφορμιγ|\\bβαρβιτ|\\bχελυ[νσ]"},
    {"q": "tears", "type": "english_concept", "pattern": "\\bδακρυ"},
    {"q": "springtime", "type": "english_concept", "pattern": "\\bεαρ|\\bειαρ|\\bηροσ\\b|\\bεαροσ"},
    {"q": "snow", "type": "english_concept", "pattern": "\\bχιον|\\bνιφ"},
    {"q": "eagle", "type": "english_concept", "pattern": "\\bαιετ|\\bαετ[οω]"},
    {"q": "wedding", "type": "english_concept", "pattern": "\\bγαμ[οεω]|\\bυμεναι|\\bυμην"},
    {"q": "dawn", "type": "english_concept", "pattern": "\\bηω[σι]?\\b|\\bηοι?\\b|\\bηουσ|\\bαυω[σι]?\\b|\\bαω[σι]?\\b"},
    {"q": "dream", "type": "english_concept", "pattern": "\\bονειρ|\\bοναρ\\b"},
    {"q": "sword", "type": "english_concept", "pattern": "\\bξιφ|\\bφασγαν"},
    {"q": "fate", "type": "english_concept", "pattern": "\\bμοιρ|\\bποτμ"},
    {"q": "desire", "type": "english_concept", "pattern": "\\bποθ(οσ|ου|ω|ον|οι|ων|εω|ει|ησ|εουσ)|\\bιμερ|\\bερ[ωο](σ|τ|ν)|\\bεπιθυμ"},
    {"q": "shield", "type": "english_concept", "pattern": "\\bασπι[δσ]|\\bσακ(οσ|εοσ|ει|εα)\\b"},
    {"q": "ἔρως", "type": "greek_lemma", "pattern": "\\bερ[ωο](σ|τοσ|τι|τα|τεσ|των|ν|ι|ω)\\b"},
    {"q": "σελήνη", "type": "greek_lemma", "pattern": "\\bσελ[ηα]νν?[αηε]|\\bσεληναι"},
    {"q": "θάνατος", "type": "greek_lemma", "pattern": "\\bθανατ"},
    {"q": "Μοῦσα", "type": "greek_lemma", "pattern": "\\bμ[οω]ι?υ?σ(α|αι|αν|ησ|ασ|αισ|αων|ων|εων)\\b"},
    {"q": "ἀηδών", "type": "greek_lemma", "pattern": "\\bαηδο[νι]|\\bαηδω"},
    {"q": "οἶνος", "type": "greek_lemma", "pattern": "\\bοιν(οσ|ου|ω|ον|οι|ων|οισ)\\b"},
    {"q": "χρυσός", "type": "greek_lemma", "pattern": "\\bχρυσ(οσ|ου|ω|ον|οι|οσ|ε|ου|ω|ον|ων|α|η|ησ|εοσ|εον|εη|εω)\\b"},
    {"q": "rose-fingered", "type": "epithet", "pattern": "β?ροδοδακτυλ"},
    {"q": "bittersweet", "type": "epithet", "pattern": "γλυκυπικρ"},
    {"q": "golden-throned", "type": "epithet", "pattern": "χρυσοθρον"},
    {"q": "violet-crowned", "type": "epithet", "pattern": "ιοστεφαν|ιοπλοκ"},
    {"q": "ox-eyed", "type": "epithet", "pattern": "βοωπι"},
    {"q": "wine-dark sea", "type": "epithet", "pattern": "οινοπ[αι]|οινοψ"},
    {"q": "grey-eyed Athena", "type": "epithet", "pattern": "γλαυκωπι"},
    {"q": "ῥοδοδάκτυλος Ἠώς", "type": "greek_phrase", "pattern": "ροδοδακτυλ"},
    {"q": "πόδας ὠκὺς Ἀχιλλεύς", "type": "greek_phrase", "pattern": "ποδασ ωκυσ|ποδαρκ"},
    {"q": "ποικιλόθρον’ ἀθανάτ’ Ἀφρόδιτα", "type": "greek_phrase", "pattern": "ποικιλοθρον"},
    {"q": "γλυκύπικρον ἀμάχανον ὄρπετον", "type": "greek_phrase", "pattern": "γλυκυπικρ|αμαχανον ορπετον"}
  ]
}
