{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://basecamp.taila44c41.ts.net:8443/api/:path*" },
    { "source": "/reader.html", "destination": "/index.html" },
    { "source": "/lexicon", "destination": "/lemma.html" },
    { "source": "/concepts", "destination": "/concept.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/authors", "destination": "/authors.html" },
    { "source": "/owner", "destination": "/owner.html" },
    { "source": "/themes", "destination": "/themes.html" },
    { "source": "/legacy", "destination": "/design-studio.html" },
    { "source": "/design-studio", "destination": "/design-studio.html" }
  ],
  "headers": [
    {
      "source": "/assets/edition-excerpts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/nature-presets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/paintings/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
