# Server only. Never use a frontend-prefixed variable for this key.
TYPESAFE_API_KEY=

# Comma-separated, exact HTTPS frontend origins for a separately hosted API.
MELOS_CORS_ORIGINS=

# Set to 1 on every publicly reachable API deployment.
MELOS_PUBLIC_DEPLOYMENT=0

# Explicit opt-in: public Jev uses durable cached decisions and atomic budgets.
MELOS_PUBLIC_CLASSIFIER=0
MELOS_JEV_MODEL=jev-1.13.0
MELOS_CLASSIFIER_DAILY_LIMIT=500
MELOS_CLASSIFIER_VISITOR_MINUTE_LIMIT=10
MELOS_CLASSIFIER_VISITOR_DAILY_LIMIT=60
MELOS_CLASSIFIER_CONCURRENCY=2
# MELOS_CLASSIFIER_STATE=/app/runtime/classifier.sqlite

# PUBLIC frontend build setting: origin only, no credentials or query string.
# Leave unset for local same-origin development.
MELOS_API_ORIGIN=
